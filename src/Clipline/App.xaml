<Application
    x:Class="Clipline.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Nothing sits behind the line but the desktop, so system acrylic has
                 nothing to blur. The glass is drawn instead: a milky fill, a bright
                 top edge and a soft shadow. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="GlassBrush" Color="#C4FFFFFF" />
                    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#33FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="RopeBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#003A322C" Offset="0" />
                        <GradientStop Color="#E63A322C" Offset="0.12" />
                        <GradientStop Color="#E63A322C" Offset="0.88" />
                        <GradientStop Color="#003A322C" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="RopeHaloBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#80FFFFFF" Offset="0.12" />
                        <GradientStop Color="#80FFFFFF" Offset="0.88" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="PegBrush" Color="#FFDDB991" />
                    <SolidColorBrush x:Key="PegEdgeBrush" Color="#40000000" />
                    <SolidColorBrush x:Key="PegSpringBrush" Color="#80705030" />
                    <SolidColorBrush x:Key="HintBrush" Color="#E6202020" />
                    <SolidColorBrush x:Key="BadgeBrush" Color="#D9202020" />
                    <SolidColorBrush x:Key="BadgeForeground" Color="#FFFFFFFF" />
                    <!-- Notes of copied text: warm paper in the glass frame. -->
                    <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFDF8" />
                    <SolidColorBrush x:Key="NoteTextBrush" Color="#FF27241F" />
                    <SolidColorBrush x:Key="NoteMutedBrush" Color="#A3554C42" />
                    <SolidColorBrush x:Key="NoteRuleBrush" Color="#17000000" />
                    <SolidColorBrush x:Key="PinBrush" Color="#FFBF7430" />
                    <SolidColorBrush x:Key="SheetBrush" Color="#F7FDFCF9" />
                    <SolidColorBrush x:Key="ChipHoverBrush" Color="#14000000" />
                    <!-- The switch between photos and text. -->
                    <SolidColorBrush x:Key="ThumbBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ThumbEdgeBrush" Color="#1F000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="GlassBrush" Color="#B32C2C30" />
                    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#59FFFFFF" Offset="0" />
                        <GradientStop Color="#0FFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="RopeBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#00F2ECE6" Offset="0" />
                        <GradientStop Color="#E6F2ECE6" Offset="0.12" />
                        <GradientStop Color="#E6F2ECE6" Offset="0.88" />
                        <GradientStop Color="#00F2ECE6" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="RopeHaloBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#66000000" Offset="0.12" />
                        <GradientStop Color="#66000000" Offset="0.88" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="PegBrush" Color="#FFB89470" />
                    <SolidColorBrush x:Key="PegEdgeBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="PegSpringBrush" Color="#99403020" />
                    <SolidColorBrush x:Key="HintBrush" Color="#F2FFFFFF" />
                    <SolidColorBrush x:Key="BadgeBrush" Color="#E6F2F2F2" />
                    <SolidColorBrush x:Key="BadgeForeground" Color="#FF1A1A1A" />
                    <SolidColorBrush x:Key="PaperBrush" Color="#F5252428" />
                    <SolidColorBrush x:Key="NoteTextBrush" Color="#F2F5F2EC" />
                    <SolidColorBrush x:Key="NoteMutedBrush" Color="#94F5F2EC" />
                    <SolidColorBrush x:Key="NoteRuleBrush" Color="#1CFFFFFF" />
                    <SolidColorBrush x:Key="PinBrush" Color="#FFEBB06C" />
                    <SolidColorBrush x:Key="SheetBrush" Color="#F7242428" />
                    <SolidColorBrush x:Key="ChipHoverBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ThumbBrush" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="ThumbEdgeBrush" Color="#29FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
