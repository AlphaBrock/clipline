<UserControl
    x:Class="Clipline.NoteCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Clipline"
    CanDrag="True">

    <!-- A note of copied text, pegged to the line like a photo: the same glass
         frame and peg, with a sheet of paper where the picture would be. -->
    <Grid x:Name="Body" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="Frame"
            Grid.Row="1"
            Padding="6"
            CornerRadius="12"
            Background="{ThemeResource GlassBrush}"
            BorderBrush="{ThemeResource GlassEdgeBrush}"
            BorderThickness="1"
            Translation="0,0,24">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <!-- The paper as written. Once laid out it is hidden behind
                     PaperShot, a picture of it, which is what swings: text
                     turned with the frame is put on whole pixels line by line,
                     so each line would hop up and down on its own. -->
                <Border
                    x:Name="Paper"
                    Padding="11,10,11,8"
                    Background="{ThemeResource PaperBrush}"
                    CornerRadius="7">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="3">
                            <!-- A colour code shows the colour. -->
                            <Border
                                x:Name="Swatch"
                                Height="44"
                                Margin="0,0,0,5"
                                BorderBrush="{ThemeResource NoteRuleBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Visibility="Collapsed" />
                            <!-- A link's site, a path's file name, an address. -->
                            <TextBlock
                                x:Name="Heading"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource NoteTextBrush}"
                                MaxLines="2"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="Preview"
                                FontSize="12.5"
                                Foreground="{ThemeResource NoteTextBrush}"
                                LineHeight="18"
                                LineStackingStrategy="BlockLineHeight"
                                MaxLines="6"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- What it is, where it came from and when. -->
                        <Grid Grid.Row="1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                x:Name="KindIcon"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{ThemeResource NoteMutedBrush}" />
                            <TextBlock
                                x:Name="Meta"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="10.5"
                                Foreground="{ThemeResource NoteMutedBrush}"
                                TextTrimming="CharacterEllipsis" />
                            <FontIcon
                                x:Name="PinMark"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{ThemeResource PinBrush}"
                                Glyph="&#xE840;"
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>

                <Image
                    x:Name="PaperShot"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Stretch="Fill"
                    Visibility="Collapsed" />

                <Border
                    x:Name="PinChip"
                    Width="22"
                    Height="22"
                    Margin="6,6,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{ThemeResource BadgeBrush}"
                    BorderBrush="{ThemeResource GlassEdgeBrush}"
                    BorderThickness="0.5"
                    CornerRadius="11"
                    Opacity="0">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Border.OpacityTransition>
                    <FontIcon
                        x:Name="PinChipGlyph"
                        FontSize="10"
                        Foreground="{ThemeResource BadgeForeground}"
                        Glyph="&#xE718;" />
                </Border>

                <Border
                    x:Name="CloseChip"
                    Width="22"
                    Height="22"
                    Margin="0,6,6,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{ThemeResource BadgeBrush}"
                    BorderBrush="{ThemeResource GlassEdgeBrush}"
                    BorderThickness="0.5"
                    CornerRadius="11"
                    Opacity="0"
                    ToolTipService.ToolTip="从历史中删除">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Border.OpacityTransition>
                    <FontIcon
                        FontSize="9"
                        Foreground="{ThemeResource BadgeForeground}"
                        Glyph="&#xE711;" />
                </Border>

                <Border
                    x:Name="Badge"
                    Padding="12,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource BadgeBrush}"
                    CornerRadius="13"
                    IsHitTestVisible="False"
                    Opacity="0">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.16" />
                    </Border.OpacityTransition>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            x:Name="BadgeGlyph"
                            FontSize="12"
                            Foreground="{ThemeResource BadgeForeground}"
                            Glyph="&#xE73E;" />
                        <TextBlock
                            x:Name="BadgeText"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource BadgeForeground}"
                            Text="已复制" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- The peg, as on a photo. -->
        <local:Peg Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top" />
    </Grid>
</UserControl>
