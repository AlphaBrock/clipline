<UserControl
    x:Class="Clipline.Peg"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="16"
    Height="30"
    IsHitTestVisible="False">

    <!-- A wooden clothespin seen from the front: a rounded prong of turned
         wood, split down its lower half where the jaws part, and a steel
         spring wound across it where the rope runs through. Raised off the
         card so it casts a small shadow onto it. -->
    <Grid Translation="0,0,10">
        <Grid.Shadow>
            <ThemeShadow />
        </Grid.Shadow>

        <!-- The wood, lit from the front: darker at the rounded sides. -->
        <Border
            Width="13"
            HorizontalAlignment="Center"
            Background="{ThemeResource PegWoodBrush}"
            BorderBrush="{ThemeResource PegEdgeBrush}"
            BorderThickness="0.5"
            CornerRadius="4,4,5,5" />
        <!-- The grain. -->
        <Rectangle
            Width="0.6"
            Margin="-5,3,0,4"
            HorizontalAlignment="Center"
            Fill="{ThemeResource PegGrainBrush}" />
        <Rectangle
            Width="0.6"
            Margin="6,5,0,2"
            HorizontalAlignment="Center"
            Fill="{ThemeResource PegGrainBrush}" />
        <!-- A gloss down the middle, where the wood faces the light. -->
        <Rectangle
            Width="3"
            Margin="-1,2,0,2"
            HorizontalAlignment="Center"
            Fill="{ThemeResource PegGlossBrush}"
            RadiusX="1.5"
            RadiusY="1.5" />
        <!-- Where the two jaws part. -->
        <Rectangle
            Width="1"
            Height="11"
            Margin="0,0,0,1"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Fill="{ThemeResource PegSplitBrush}"
            RadiusX="0.5"
            RadiusY="0.5" />

        <!-- The spring, a little wider than the wood it is wound around. -->
        <Border
            Height="4.5"
            Margin="0,6,0,0"
            VerticalAlignment="Top"
            Background="{ThemeResource PegSpringBrush}"
            BorderBrush="{ThemeResource PegSpringEdgeBrush}"
            BorderThickness="0.5"
            CornerRadius="2.25" />
        <Rectangle
            Height="0.6"
            Margin="2,7.2,2,0"
            VerticalAlignment="Top"
            Fill="{ThemeResource PegSpringShineBrush}" />
    </Grid>
</UserControl>
