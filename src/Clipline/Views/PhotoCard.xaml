<UserControl
    x:Class="Clipline.PhotoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CanDrag="True">

    <!-- The whole card swings from the peg, moved by the rope's simulation. -->
    <Grid x:Name="Body" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The glass frame -->
        <Border
            x:Name="Frame"
            Grid.Row="1"
            Padding="6"
            CornerRadius="12"
            Background="{ThemeResource GlassBrush}"
            BorderBrush="{ThemeResource GlassEdgeBrush}"
            BorderThickness="1"
            Translation="0,0,24">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Border CornerRadius="7">
                    <Image x:Name="Picture" Stretch="UniformToFill" />
                </Border>

                <!-- A recording says so with a play button over its first frame. -->
                <Border
                    x:Name="PlayBadge"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource BadgeBrush}"
                    CornerRadius="20"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <FontIcon
                        Margin="3,0,0,0"
                        FontSize="16"
                        Foreground="{ThemeResource BadgeForeground}"
                        Glyph="&#xF5B0;" />
                </Border>
                <Border
                    x:Name="DurationBadge"
                    Margin="0,0,6,6"
                    Padding="6,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource BadgeBrush}"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="Duration"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource BadgeForeground}" />
                </Border>

                <!-- Shown on hover, and always once pinned, to say so. -->
                <Border
                    x:Name="PinChip"
                    Width="22"
                    Height="22"
                    Margin="6,6,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    CornerRadius="11"
                    Background="{ThemeResource BadgeBrush}"
                    Opacity="0">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Border.OpacityTransition>
                    <FontIcon
                        x:Name="PinChipGlyph"
                        FontSize="10"
                        Foreground="{ThemeResource BadgeForeground}"
                        Glyph="&#xE718;" />
                </Border>

                <Border
                    x:Name="CloseChip"
                    Width="22"
                    Height="22"
                    Margin="0,6,6,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    CornerRadius="11"
                    Background="{ThemeResource BadgeBrush}"
                    Opacity="0"
                    ToolTipService.ToolTip="从晾衣绳上取下">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Border.OpacityTransition>
                    <FontIcon
                        FontSize="9"
                        Foreground="{ThemeResource BadgeForeground}"
                        Glyph="&#xE711;" />
                </Border>

                <Border
                    x:Name="CopiedBadge"
                    Padding="12,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="13"
                    Background="{ThemeResource BadgeBrush}"
                    IsHitTestVisible="False"
                    Opacity="0">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.18" />
                    </Border.OpacityTransition>
                    <TextBlock
                        x:Name="BadgeText"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource BadgeForeground}"
                        Text="已复制" />
                </Border>
            </Grid>
        </Border>

        <!-- The peg, on top of the frame's edge. The rope runs through it. -->
        <Grid
            Grid.RowSpan="2"
            Width="14"
            Height="26"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <Border
                Background="{ThemeResource PegBrush}"
                BorderBrush="{ThemeResource PegEdgeBrush}"
                BorderThickness="0.5"
                CornerRadius="3" />
            <Rectangle
                Height="1.5"
                Margin="2,8,2,0"
                VerticalAlignment="Top"
                Fill="{ThemeResource PegSpringBrush}" />
        </Grid>
    </Grid>
</UserControl>
