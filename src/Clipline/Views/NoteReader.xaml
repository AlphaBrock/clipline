<UserControl
    x:Class="Clipline.NoteReader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ReaderButton" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="ReaderGlyph" TargetType="FontIcon">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource NoteTextBrush}" />
        </Style>
    </UserControl.Resources>

    <!-- A whole note, held up to read: everything it says, and what can be
         done with it. -->
    <Grid>
        <!-- Never shown: they hold brushes for the code to use, following the theme. -->
        <Border
            x:Name="HoverColour"
            Background="{ThemeResource ChipHoverBrush}"
            BorderBrush="{ThemeResource NoteTextBrush}"
            Visibility="Collapsed" />
        <Border x:Name="PinColour" Background="{ThemeResource PinBrush}" Visibility="Collapsed" />
        <Border
            x:Name="Sheet"
            Background="{ThemeResource SheetBrush}"
            BorderBrush="{ThemeResource GlassEdgeBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Translation="0,0,40">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Code is read on the same dark sheet it hangs on. -->
                <Border
                    x:Name="CodeBackdrop"
                    Grid.RowSpan="2"
                    Background="{ThemeResource CodePaperBrush}"
                    CornerRadius="13"
                    Visibility="Collapsed" />

                <Grid Padding="14,8,8,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        x:Name="KindIcon"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource NoteMutedBrush}" />
                    <TextBlock
                        x:Name="Meta"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource NoteMutedBrush}"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Border
                            x:Name="CopyButton"
                            Height="30"
                            Margin="0,0,4,0"
                            Padding="12,0,14,0"
                            Background="{ThemeResource BadgeBrush}"
                            CornerRadius="15">
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="7">
                                <FontIcon
                                    x:Name="CopyGlyph"
                                    FontSize="12"
                                    Foreground="{ThemeResource BadgeForeground}"
                                    Glyph="&#xE8C8;" />
                                <TextBlock
                                    x:Name="CopyLabel"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource BadgeForeground}"
                                    Text="复制" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="OpenButton" Style="{StaticResource ReaderButton}">
                            <FontIcon x:Name="OpenGlyph" Glyph="&#xE8A7;" Style="{StaticResource ReaderGlyph}" />
                        </Border>
                        <Border x:Name="PinButton" Style="{StaticResource ReaderButton}">
                            <FontIcon x:Name="PinGlyph" Glyph="&#xE718;" Style="{StaticResource ReaderGlyph}" />
                        </Border>
                        <Border
                            x:Name="DeleteButton"
                            Style="{StaticResource ReaderButton}"
                            ToolTipService.ToolTip="从历史中删除">
                            <FontIcon Glyph="&#xE74D;" Style="{StaticResource ReaderGlyph}" />
                        </Border>
                        <Border
                            x:Name="CloseButton"
                            Style="{StaticResource ReaderButton}"
                            ToolTipService.ToolTip="关闭">
                            <FontIcon
                                FontSize="11"
                                Glyph="&#xE711;"
                                Style="{StaticResource ReaderGlyph}" />
                        </Border>
                    </StackPanel>
                </Grid>
                <Rectangle
                    Height="1"
                    Margin="14,0"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource NoteRuleBrush}" />

                <ScrollViewer
                    x:Name="Scroller"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16,12,18,16" Spacing="10">
                        <Border
                            x:Name="Swatch"
                            Height="64"
                            BorderBrush="{ThemeResource NoteRuleBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="Full"
                            FontSize="13.5"
                            Foreground="{ThemeResource NoteTextBrush}"
                            IsTextSelectionEnabled="True"
                            LineHeight="21"
                            TextWrapping="Wrap" />
                        <!-- Code as in an editor: numbered lines, never wrapped,
                             scrolled sideways when they run long. -->
                        <Grid x:Name="CodeArea" ColumnSpacing="14" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="LineNumbers"
                                FontSize="12.5"
                                Foreground="#5C6370"
                                IsTextSelectionEnabled="False"
                                LineHeight="19"
                                LineStackingStrategy="BlockLineHeight"
                                TextAlignment="Right" />
                            <ScrollViewer
                                Grid.Column="1"
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <TextBlock
                                    x:Name="CodeText"
                                    Padding="0,0,0,10"
                                    FontSize="12.5"
                                    IsTextSelectionEnabled="True"
                                    LineHeight="19"
                                    LineStackingStrategy="BlockLineHeight"
                                    TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </Grid>
                        <TextBlock
                            x:Name="More"
                            FontSize="12"
                            Foreground="{ThemeResource NoteMutedBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
