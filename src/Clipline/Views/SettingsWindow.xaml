<Window
    x:Class="Clipline.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="SectionHeader" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="1,28,0,6" />
            </Style>
            <Style x:Key="PathText" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
            <!-- The changelog's parts, built in code from CHANGELOG.md. -->
            <Style x:Key="ChangelogVersion" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock" />
            <Style x:Key="ChangelogMeta" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="ChangelogItem" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="TitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="20" Height="20" Source="ms-appx:///Assets/Clipline-titlebar.png" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Clipline 设置" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="36,0,36,36">
            <StackPanel MaxWidth="980" Spacing="4">
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="设置" />

                <!-- The line -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="晾衣绳" />
                <toolkit:SettingsExpander
                    x:Name="EdgeCard"
                    Description="两端角落不会触发，留给最大化窗口的关闭按钮。"
                    Header="鼠标停在屏幕顶边时放下"
                    IsExpanded="True">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE962;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <ToggleSwitch x:Name="RevealAtEdge" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard x:Name="DelayCard" Header="停留多久才放下">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock
                                    x:Name="RevealDelayText"
                                    MinWidth="56"
                                    VerticalAlignment="Center"
                                    TextAlignment="Right" />
                                <Slider
                                    x:Name="RevealDelay"
                                    Width="200"
                                    Maximum="600"
                                    Minimum="0"
                                    StepFrequency="20" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsCard Description="截图或录屏一保存，晾衣绳就下来一会儿，让你看到它挂上去。" Header="有新截图时放下">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE722;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="RevealOnCapture" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard Description="玩游戏、看视频或放幻灯片时，顶边不会触发。" Header="全屏时保持安静">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE740;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="QuietInFullScreen" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard Description="屏幕放不下时会少一些。其余的可以用滚轮翻看。" Header="同时显示">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE80A;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            x:Name="MaxVisibleText"
                            MinWidth="40"
                            VerticalAlignment="Center"
                            TextAlignment="Right" />
                        <Slider
                            x:Name="MaxVisible"
                            Width="200"
                            Maximum="8"
                            Minimum="3"
                            SnapsTo="StepValues"
                            StepFrequency="1"
                            TickFrequency="1"
                            TickPlacement="Outside" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard Description="再多的话，最早的一张会被取下来。文件本身不会动。" Header="绳上最多保留">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="MaxHanging"
                        Width="140"
                        LargeChange="10"
                        Maximum="200"
                        Minimum="5"
                        SmallChange="5"
                        SpinButtonPlacementMode="Inline" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard Description="置顶的截图和录屏排在最前面，不会因为超出数量被取下，启动时也会挂上。点照片左上角的图钉置顶。" Header="最多置顶">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE718;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="MaxPinnedCaptures"
                        Width="140"
                        Maximum="10"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard Description="下次启动时生效。" Header="启动时挂上最近几张">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE81C;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="RecentAtLaunch"
                        Width="140"
                        Maximum="20"
                        Minimum="0"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline" />
                </toolkit:SettingsCard>

                <!-- Captures -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="截图和录屏" />
                <toolkit:SettingsCard Header="截图文件夹">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Name="ScreenshotFolderText" Style="{StaticResource PathText}" />
                    </toolkit:SettingsCard.Description>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ScreenshotFolderReset" Content="恢复默认" />
                        <Button x:Name="ScreenshotFolderPick" Content="更改…" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <toolkit:SettingsExpander
                    Description="Snipping Tool 录下的视频也挂上去，带播放按钮和时长。长按可以裁剪。"
                    Header="也挂上录屏"
                    IsExpanded="True">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE714;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <ToggleSwitch x:Name="HangRecordings" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard x:Name="RecordingFolderCard" Header="录屏文件夹">
                            <toolkit:SettingsCard.Description>
                                <TextBlock x:Name="RecordingFolderText" Style="{StaticResource PathText}" />
                            </toolkit:SettingsCard.Description>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="RecordingFolderReset" Content="恢复默认" />
                                <Button x:Name="RecordingFolderPick" Content="更改…" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsExpander
                    Description="也挂上 Snipping Tool、Snipaste、PixPin，以及 QQ、微信、企业微信自带截图等只复制到剪贴板、没有存成文件的截图。浏览器或聊天里复制的图片不算。"
                    Header="也挂上剪贴板里的截图"
                    IsExpanded="True">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE77F;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <ToggleSwitch x:Name="HangClipboardScreenshots" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Header="自动清理">
                            <toolkit:SettingsCard.Description>
                                <TextBlock x:Name="ClipboardScreenshotDaysText" Style="{StaticResource PathText}" TextWrapping="Wrap" />
                            </toolkit:SettingsCard.Description>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox
                                    x:Name="ClipboardScreenshotDays"
                                    Width="140"
                                    LargeChange="30"
                                    Maximum="3650"
                                    Minimum="0"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Inline" />
                                <TextBlock VerticalAlignment="Center" Text="天" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsCard Header="也挂上 Xbox Game Bar 的截图和录像">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Name="GameBarFolderText" Style="{StaticResource PathText}" />
                    </toolkit:SettingsCard.Description>
                    <ToggleSwitch x:Name="HangGameBarCaptures" />
                </toolkit:SettingsCard>

                <!-- Copied text -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="剪贴板文字" />
                <toolkit:SettingsExpander
                    Description="复制过的文字像便签一样夹在晾衣绳的「文字」一侧，点一下再次复制，双击看全文，长按置顶，绳下的放大镜可以搜索。密码管理器复制的密码不会记录。"
                    Header="记录复制的文字"
                    IsExpanded="True">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE70B;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <ToggleSwitch x:Name="KeepClipboardText" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard x:Name="MaxTextHistoryCard" Description="再多的话，最早的一条会被删掉。置顶的不算在内。" Header="最多保留">
                            <NumberBox
                                x:Name="MaxTextHistory"
                                Width="140"
                                LargeChange="50"
                                Maximum="200"
                                Minimum="10"
                                SmallChange="10"
                                SpinButtonPlacementMode="Inline" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Name="TextHistoryDaysCard" Header="自动删除">
                            <toolkit:SettingsCard.Description>
                                <TextBlock x:Name="TextHistoryDaysText" Style="{StaticResource PathText}" TextWrapping="Wrap" />
                            </toolkit:SettingsCard.Description>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox
                                    x:Name="TextHistoryDays"
                                    Width="140"
                                    LargeChange="30"
                                    Maximum="3650"
                                    Minimum="0"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Inline" />
                                <TextBlock VerticalAlignment="Center" Text="天" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Name="MaxPinnedTextCard" Description="置顶的文字排在最前面，清空历史和自动删除时都会留下。" Header="最多置顶">
                            <NumberBox
                                x:Name="MaxPinnedText"
                                Width="140"
                                Maximum="20"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Name="ClearTextHistoryCard" Header="清空历史">
                            <toolkit:SettingsCard.Description>
                                <TextBlock x:Name="TextHistoryText" Style="{StaticResource PathText}" />
                            </toolkit:SettingsCard.Description>
                            <Button x:Name="ClearTextHistory" Content="清空" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <!-- Shortcut -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="快捷键" />
                <toolkit:SettingsExpander
                    Description="在任何地方按下它，显示或收起晾衣绳。"
                    Header="显示或隐藏晾衣绳"
                    IsExpanded="True">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE765;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <ToggleSwitch x:Name="HotKeyEnabled" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard x:Name="HotKeyCard" Description="点一下，再按下想用的组合键。按 Esc 取消。" Header="组合键">
                            <Button x:Name="HotKeyButton" MinWidth="160">
                                <TextBlock x:Name="HotKeyText" FontFamily="Cascadia Mono, Consolas" />
                            </Button>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <InfoBar
                    x:Name="HotKeyProblem"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning" />

                <!-- Look and feel -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="外观" />
                <toolkit:SettingsCard Header="主题">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="Theme" MinWidth="160">
                        <ComboBoxItem Content="跟随系统" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                    </ComboBox>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="照片不再摆动，绳子不再回弹。Windows 关闭了动画效果时也会这样。" Header="减少动画">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE945;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="ReduceMotion" />
                </toolkit:SettingsCard>

                <!-- Launch -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="启动" />
                <toolkit:SettingsCard Header="登录 Windows 时启动">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="LaunchAtSignIn" />
                </toolkit:SettingsCard>
                <InfoBar
                    x:Name="LaunchProblem"
                    IsClosable="True"
                    IsOpen="False"
                    Message="Windows 没有允许它开机启动。可以在 设置 › 应用 › 启动 或任务管理器的「启动应用」里打开。"
                    Severity="Warning" />

                <!-- About -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="关于" />
                <toolkit:SettingsCard x:Name="AboutCard" Header="Clipline">
                    <toolkit:SettingsCard.Resources>
                        <!-- The app's own icon, larger than the glyphs on the other cards. -->
                        <x:Double x:Key="SettingsCardHeaderIconMaxSize">40</x:Double>
                    </toolkit:SettingsCard.Resources>
                    <toolkit:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/Clipline-about.png" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Name="AboutText" Style="{StaticResource PathText}" />
                    </toolkit:SettingsCard.Description>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton x:Name="ProjectLink" Content="项目主页" Visibility="Collapsed" />
                        <Button x:Name="OpenLogs" Content="打开数据文件夹" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <toolkit:SettingsExpander x:Name="ChangelogCard" Header="更新日志">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <HyperlinkButton x:Name="ReleasesLink" Content="所有版本" Visibility="Collapsed" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Left">
                            <StackPanel x:Name="ChangelogPanel" Padding="0,4,0,8" Spacing="24" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
